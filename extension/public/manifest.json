{
  "manifest_version": 3,
  "name": "Goalden",
  "description": "A progress gate for distracting feeds.",
  "version": "0.1.0",
  "action": {
    "default_title": "Open Goalden"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["alarms", "declarativeNetRequest", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://rlhaibdgdgczlgpgdnag.supabase.co/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "assets/*"],
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*"
      ]
    }
  ]
}
